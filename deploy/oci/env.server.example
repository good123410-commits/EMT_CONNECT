# /opt/emt-connect/.env — OCI 서버 전용 (Git에 커밋하지 마세요)
# cp deploy/oci/env.server.example .env 후 값을 채우고 chmod 600 .env

# Supabase (Node 동기화 스크립트)
SUPABASE_URL=https://cdkyoeskhrwrpxgbmpqu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 재난안전데이터 — OCI 공인 IP와 포털 유치 IP가 일치해야 함
SAFETYDATA_REGISTERED_IP=132.145.126.224
SAFETYDATA_SERVICE_KEY_WEATHER=
SAFETYDATA_SERVICE_KEY_FOREST=
SAFETYDATA_SERVICE_KEY_DISASTER=
# 또는 공통 키 하나:
# SAFETYDATA_SERVICE_KEY=

# (선택) E-Gen 심야약국 CSV
# EGEN_MIDNIGHT_CSV_URL=https://www.e-gen.or.kr/egen/pharmacyList_list_csv.do
# EGEN_STRICT_TLS=true
