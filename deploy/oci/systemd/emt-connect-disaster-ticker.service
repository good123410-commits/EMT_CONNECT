[Unit]
Description=EMT Connect — disaster ticker sync (safetydata → Supabase)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/.env
ExecStart=@NODE_BIN@ scripts/sync-disaster-ticker.mjs
Nice=10
IOSchedulingClass=best-effort

[Install]
WantedBy=multi-user.target
