# EXPO_NO_CACHE=1  (Expo API 캐시 비활성화 — Body has already been read 오류 시)

# Supabase (Expo Go·실기기 — 반드시 EXPO_PUBLIC_ 접두사 + 공인 HTTPS URL)
# localhost / 127.0.0.1 은 모바일에서 PC 로컬을 가리켜 연결 실패합니다.
EXPO_PUBLIC_SUPABASE_URL=https://cdkyoeskhrwrpxgbmpqu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
# 공공데이터포털 API (필수 — 아래 API 활용 신청 후 동일 키 사용)
# - 국립중앙의료원 응급의료정보 (응급실/AED/약국)
# - 국립중앙의료원 병·의원 찾기 (소아/달빛어린이병원·진료시간)
# - 식약처 e약은요 (의약품 검색)
# - 화학물질안전원 화학물질안전관리정보 (독성물질)
EXPO_PUBLIC_PORTAL_API_KEY=your_data_go_kr_service_key_here

# 재난안전데이터 공유플랫폼 (홈 긴급 전광판 — 기상특보·산불·재난문자)
# https://www.safetydata.go.kr 에서 API별 키 발급 후 .env에 저장
# SAFETYDATA_SERVICE_KEY_WEATHER=...
# SAFETYDATA_SERVICE_KEY_FOREST=...
# SAFETYDATA_SERVICE_KEY_DISASTER=...
# SAFETYDATA_REGISTERED_IP=1.214.117.34  (포털 유치아이피 — 진단 로그용)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 는 Node 스크립트·Edge Function 전용입니다.
# 모바일 앱(Expo)은 위 EXPO_PUBLIC_* 만 사용합니다.
#
# 로컬 동기화 (권장 — 유치아이피 등록 PC에서 실행)
#   npm run sync:disaster-ticker:check   # API 키·IP 진단
#   npm run sync:disaster-ticker           # Supabase 캐시 동기화
#   npm run sync:disaster-ticker:dry-run   # API만 테스트 (DB 미기록)
#   .\scripts\register-disaster-ticker-task.ps1  # Windows 10분 스케줄
#
# Edge Function (선택 — 별도 egress IP 등록 필요)
#   scripts/deploy-sync-disaster-ticker.ps1
#   supabase/migrations/sync_disaster_ticker_cron.sql

# Google Maps (Android 지도 탭 — EAS 빌드 시 Secrets에도 등록 필요)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# KEMIX 웹 자료실 URL (자료 공유 링크용, 선택)
# EXPO_PUBLIC_KEMIX_WEB_URL=https://your-kemix-site.com

# 카카오 JavaScript / Navi SDK 키 (카카오맵 길찾기)
EXPO_PUBLIC_KAKAO_JS_KEY=5b1196fad925c9e496d0fb6f9d416318

# RESEND_API_KEY=re_xxxx   → scripts/set-edge-function-secrets.ps1 또는 Supabase 대시보드
# INVITE_EMAIL_FROM=EMS Connect <onboarding@resend.dev>

# GitHub Actions 심야약국 동기화 (scripts/sync-midnight-pharmacies.mjs)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# EGEN_MIDNIGHT_CSV_URL=https://www.e-gen.or.kr/egen/pharmacyList_list_csv.do  (기본값)
# EGEN_STRICT_TLS=true  (E-Gen 인증서 엄격 검증 — 기본은 완화 모드)
# ALLOW_LOCAL_CSV_FALLBACK=true  (로컬 개발 시 E-Gen 다운로드 실패 시 assets CSV 폴백)
